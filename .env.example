# Copy to .env and set your Komoot credentials.
# Never commit .env — each Mac needs its own file.

KOMOOT_EMAIL=you@example.com
KOMOOT_PASSWORD=your_password

# Optional paths (macOS Zwift defaults)
# ZWIFT_ACTIVITIES_DIR=~/Documents/Zwift/Activities
# ZWIFT_LOGS_DIR=~/Documents/Zwift/Logs
# ZWIFT_PHOTOS_DIR=~/Pictures/Zwift

# Tour visibility: private | friends | public
# KOMOOT_PRIVACY=private

# Min FIT size in KB (skips incomplete rides)
# inProgressActivity.fit is always ignored
# *_clean.jpg screenshots are always skipped
MIN_FIT_KB=5
